{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Electron desktop shell over the DeepSeek Harness web composition. Loopback mode reuses the browser transport unchanged; the IPC mode (DSH_DESKTOP_TRANSPORT=ipc) is the documented Electron carrier direction and is scaffolded behind the env switch.",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "main": "lib/main/index.js",
  "exports": {
    "./directory-picker": {
      "types": "./lib/main/directory-picker.d.ts",
      "default": "./lib/main/directory-picker.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm --filter @deepseek-ai/dsh-web-frontend build && tsc -p tsconfig.json && electron .",
    "icons": "node scripts/gen-icons.mjs",
    "fonts": "node scripts/gen-shell-fonts.mjs",
    "stage-app": "node scripts/stage-app.mjs",
    "package": "pnpm icons && pnpm build && pnpm stage-app && node scripts/package-app.mjs",
    "package:win": "pnpm icons && pnpm build && pnpm stage-app && node scripts/package-app.mjs --win"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
    "@deepseek-ai/cordis-plugin-hmr": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/cordis-plugin-timer": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-base": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@deepseek-ai/dsh-client-modules": "workspace:^",
    "@deepseek-ai/dsh-client-ui-directory-picker-native": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-host-apiproxy": "workspace:^",
    "@deepseek-ai/dsh-host-directory-picker": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^",
    "@deepseek-ai/dsh-web-app": "workspace:^",
    "@deepseek-ai/dsh-web-frontend": "workspace:^",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "electron": "^39.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "io.github.sans41478.deepseek-harness-desktop",
    "productName": "DeepSeek Harness Desktop",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "lib/**/*",
      "config/**/*"
    ],
    "asar": false,
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/koffi/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "dir",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DeepSeek Harness Desktop"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true
    },
    "publish": {
      "provider": "github",
      "owner": "SANS41478",
      "repo": "deepseek-harness-desktop"
    }
  },
  "license": "MIT"
}
